# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
# Digunakan untuk fitur AI inti: narasi rute dinamis (1A) dan sesuaikan preferensi rute (1B)
# Jika dikosongkan, sistem otomatis berjalan menggunakan Subak Spatial Deterministic Engine (Zero-Crash Mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude API Key (Opsional - secondary engine)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Carto Basemap API Key (Get from https://carto.com/basemaps/apikey)
# Digunakan untuk tile resmi Carto Voyager dengan otentikasi API.
# Jika dikosongkan, sistem otomatis fallback ke OpenStreetMap resmi (Zero-Crash & Zero-Watermark).
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
