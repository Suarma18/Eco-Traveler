# Anthropic Claude API Key (Get from https://console.anthropic.com/)
# Digunakan untuk fitur AI nyata: narasi rute dinamis (1A) dan sesuaikan preferensi rute (1B)
# Jika dikosongkan, sistem otomatis berjalan dengan mode fallback deterministik tanpa badge AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
# Jika dikosongkan, sistem otomatis berjalan menggunakan Deterministic Fallback Engine (Zero-Crash Mode)
GEMINI_API_KEY=

# Opsional: Model Gemini yang digunakan (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Carto Basemap API Key (Get from https://carto.com/basemaps/apikey)
# Digunakan untuk tile resmi Carto Voyager dengan otentikasi API.
# Jika dikosongkan, sistem otomatis fallback ke OpenStreetMap resmi (Zero-Crash & Zero-Watermark).
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
